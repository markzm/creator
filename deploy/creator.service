[Unit]
Description=Creator v6 Worldbuilding Studio Service
After=network.target

[Service]
Type=simple
User=ctyun
Group=ctyun
WorkingDirectory=/data/creator
EnvironmentFile=-/data/creator/deploy/creator.env
ExecStart=/data/creator/bin/creator serve
Restart=always
RestartSec=3
LimitNOFILE=65536

# Security hardening
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
