# 设定创作器 v6 服务配置 (/data/creator/deploy/creator.env)
LISTEN_ADDR=0.0.0.0:8080
DATA_DIR=/data/creator/data
DB_PATH=/data/creator/data/app.db
AVATAR_DIR=/data/creator/data/avatars
STATIC_DIR=/data/creator/web/dist
SERVE_STATIC=true

# 注册模式: open (默认开放注册，带防刷验证码与限流) | invite (邀请码) | closed (关闭)
REGISTER_MODE=open

# 无域名 IP 访问时设为 false；后期绑定域名开启 HTTPS 后设为 true
SECURE_COOKIE=false
ALLOWED_ORIGIN=

# 超级管理员邮箱：该账号注册后，服务启动时自动提升为超级管理员（也可用 `creator user promote --email X --super`）
SUPER_ADMIN_EMAIL=

# HMAC 挑战签名 / AI 密钥加密密钥。生产环境必须设置且妥善保管（生成：openssl rand -hex 32）
SECRET_KEY=

# 允许用户自定义 AI 接口指向的额外域名（逗号分隔；默认已允许 api.deepseek.com / api.siliconflow.cn / openrouter.ai / api.openai.com）
ALLOWED_AI_HOSTS=

# 公共免费 AI 引擎配置 (OpenRouter API)
# 获取地址: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODELS=deepseek/deepseek-chat-v3-0324:free,qwen/qwen3-235b-a22b:free,google/gemini-2.0-flash-exp:free,meta-llama/llama-3.3-70b-instruct:free,openrouter/free

