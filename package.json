{
  "name": "worldbuilding-studio",
  "version": "6.7.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:web": "cd web && npm run build",
    "build": "npm run build:web",
    "dev": "wrangler dev",
    "deploy": "npm run build:web && wrangler deploy",
    "d1:create": "wrangler d1 create creator-db",
    "d1:migrate:local": "npm run d1:preflight:local && wrangler d1 migrations apply creator-db --local",
    "d1:migrate:remote": "npm run d1:preflight:remote && wrangler d1 migrations apply creator-db --remote",
    "r2:create": "wrangler r2 bucket create creator-avatars",
    "d1:preflight:local": "node scripts/check-super-admin.mjs",
    "d1:preflight:remote": "node scripts/check-super-admin.mjs --remote",
    "test:worker": "node --test worker/tests/*.test.mjs",
    "typecheck:worker": "tsc --noEmit -p worker/tsconfig.json",
    "test:e2e:worker": "npm run build:web && node scripts/test-worker-e2e.mjs"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261027.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.17.0",
    "esbuild": "0.28.2",
    "miniflare": "5.20261023.0-beta",
    "typescript": "^5.7.2",
    "wrangler": "^4.153.0"
  }
}
